# Local dev override — points the frontend at the new FrankenPHP/Octane
# staging environment instead of the default http://localhost:8000.
#
# Requires (one-time, per machine):
#   1. Add to your hosts file:  192.168.100.50 omni360.local
#      (Windows: C:\Windows\System32\drivers\etc\hosts, needs admin rights)
#   2. Visit https://omni360.local once in the browser and accept the
#      self-signed Caddy certificate warning.
#
# To go back to localhost:8000, just delete this file (or comment the line
# below) — src/services/api/client.ts falls back to localhost:8000 when
# VITE_API_BASE_URL is unset.
VITE_API_BASE_URL=https://omni360.local